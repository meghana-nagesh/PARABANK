<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank Cross-Browser Suite">
    <listeners>
        <listener class-name="com.meghana.parabank.listeners.TestListener"/>
    </listeners>
    <test name="ParaBank Cross-Browser">
        <groups>
            <run>
                <include name="crossbrowser"/>
            </run>
        </groups>
        <packages>
            <package name="com.meghana.parabank.tests"/>
        </packages>
    </test>
</suite>
