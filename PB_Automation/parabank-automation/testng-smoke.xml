<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Quick check of the main flows:  mvn test -DsuiteFile=testng-smoke.xml
     Cross-browser check:            mvn test -DsuiteFile=testng-crossbrowser.xml -Dbrowser=firefox -->
<suite name="ParaBank Smoke Suite">
    <listeners>
        <listener class-name="com.meghana.parabank.listeners.TestListener"/>
    </listeners>
    <test name="ParaBank Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.meghana.parabank.tests"/>
        </packages>
    </test>
</suite>
